# 다람쥐 택시 — 기사님(관리자) 프론트엔드 환경변수
# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요.

# 백엔드 API 주소 (이미 배포됨, 24/7)
NEXT_PUBLIC_API_BASE_URL=https://daramjwi-taxi-server.vercel.app

# Supabase — OTP 로그인 + 실시간 동기화에 사용 (anon key 는 공개되어도 안전, RLS 가 보호)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# 개발용 로그인 버튼 노출 여부 (SMS OTP 연동 전까지 true).
# 운영 오픈 시 false 로 두거나 변수 자체를 빼세요.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# ❗ SUPABASE_SERVICE_ROLE_KEY 는 절대 프론트에 두지 마세요 (백엔드 전용).
